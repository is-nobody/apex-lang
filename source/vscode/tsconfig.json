{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "types": ["node", "vscode"]
  },
  "include": [
    "extension.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".vscode-test"]
}