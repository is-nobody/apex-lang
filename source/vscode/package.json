{
  "name": "apex-lang",
  "displayName": "apex-lang",
  "description": "Language support for the Apex programming language",
  "version": "26.0.9",
  "icon": "logo.png",
  "publisher": "is-nobody",
  "engines": {
    "vscode": "^1.60.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/is-nobody/apex-lang"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:apex"
  ],
  "main": "./extension.js",
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "prepackage": "npm run build:ts",
    "package": "vsce package",
    "prepublish": "npm run build:ts",
    "publish": "vsce publish",
    "vscode:prepublish": "npm run build:ts"
  },
  "contributes": {
    "languages": [
      {
        "id": "apex",
        "aliases": [
          "Apex",
          "apex"
        ],
        "extensions": [
          ".apex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "apex",
        "scopeName": "source.apex",
        "path": "./syntaxes/apex.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "apex.runFile",
        "title": "Apex: Run Current File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "apex.runFile",
          "group": "navigation",
          "when": "editorLangId == apex"
        }
      ]
    },
    "keybindings": [
      {
        "command": "apex.runFile",
        "key": "f5",
        "when": "editorLangId == apex"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.60.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  }
}